{
  "type": "module",
  "scripts": {
    "pidp:build:metadata": "npm --prefix ../pidp/serverless run build:metadata",
    "pretypecheck": "npm run pidp:build:metadata",
    "pretest": "npm run pidp:build:metadata",
    "docker:serve": "scripts/serve-docker.sh",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "npm --prefix ../pidp/serverless test",
    "db:migrate:local": "wrangler d1 migrations apply faith-and-eve-pidp --local",
    "db:migrate:remote": "wrangler d1 migrations apply faith-and-eve-pidp --remote"
  },
  "dependencies": {
    "hono": "^4.8.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.8.3",
    "wrangler": "^4.132.0"
  }
}
